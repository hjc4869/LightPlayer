; --- rectangular clip: only the left half of the line survives
Dialogue: 0,0:00:00.00,0:00:08.00,Small,,0,0,0,,{\pos(640,60)}clip rectangle: only the part inside 0,0 - 640,720 is drawn
Dialogue: 0,0:00:00.00,0:00:08.00,Default,,0,0,0,,{\pos(640,130)\clip(0,0,640,720)}LEFT HALF ONLY

; --- inverse rectangular clip: the same rectangle, the other way round
Dialogue: 0,0:00:00.00,0:00:08.00,Small,,0,0,0,,{\pos(640,220)}iclip rectangle: the same rectangle, everything outside it
Dialogue: 0,0:00:00.00,0:00:08.00,Default,,0,0,0,,{\pos(640,290)\iclip(0,0,640,720)}RIGHT HALF ONLY

; --- vector clip
Dialogue: 0,0:00:00.00,0:00:08.00,Small,,0,0,0,,{\pos(640,380)}clip vector: a diamond cut out of the line
Dialogue: 0,0:00:00.00,0:00:08.00,Default,,0,0,0,,{\pos(640,450)\clip(m 640 380 l 900 450 l 640 520 l 380 450)}DIAMOND CLIP

; --- inverse vector clip
Dialogue: 0,0:00:00.00,0:00:08.00,Small,,0,0,0,,{\pos(640,540)}iclip vector: a smaller diamond punched out of the middle
Dialogue: 0,0:00:00.00,0:00:08.00,Default,,0,0,0,,{\pos(640,610)\iclip(m 640 555 l 760 610 l 640 665 l 520 610)}DIAMOND HOLE

; --- animated rectangular clip: a left-to-right wipe
Dialogue: 0,0:00:08.20,0:00:16.00,Small,,0,0,0,,{\pos(640,200)}an animated clip rectangle is the standard left to right wipe
Dialogue: 0,0:00:08.20,0:00:16.00,Default,,0,0,0,,{\pos(640,280)\clip(160,0,160,720)\t(0,4000,\clip(160,0,1120,720))}WIPING IN

; --- animated inverse clip: a wipe that removes the line instead
Dialogue: 0,0:00:08.20,0:00:16.00,Small,,0,0,0,,{\pos(640,400)}the same animation on iclip erases the line
Dialogue: 0,0:00:08.20,0:00:16.00,Default,,0,0,0,,{\pos(640,480)\iclip(160,0,160,720)\t(0,4000,\iclip(160,0,1120,720))}WIPING OUT

; --- clip with a \p scale
Dialogue: 0,0:00:08.20,0:00:16.00,Small,,0,0,0,,{\pos(640,580)}a vector clip may carry its own coordinate scale
Dialogue: 0,0:00:08.20,0:00:16.00,Default,,0,0,0,,{\pos(640,650)\clip(2,m 700 1200 l 1860 1200 l 1860 1400 l 700 1400)}SCALED CLIP
