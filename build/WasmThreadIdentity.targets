<Project>
  <!--
    CoreLib's Lock needs distinct thread IDs on the threaded WebAssembly runtime; the wrapper returns
    Emscripten's pthread_self(). Review this override after upgrading the .NET runtime:
    https://github.com/dotnet/runtime/issues/129900
  -->
  <PropertyGroup>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -Wl,--wrap=SystemNative_TryGetUInt32OSThreadId</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <NativeFileReference Include="$(MSBuildThisFileDirectory)wasm-thread-id.cpp" />
  </ItemGroup>
</Project>
