<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Keeps the default global public feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="lightstudio-lightplayer" value="https://www.myget.org/F/lightstudio-lightplayer/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- key value for <packageSource> should match key values from <packageSources> element -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Avalonia" />
      <package pattern="Avalonia.Android" />
      <package pattern="Avalonia.Browser" />
      <package pattern="Avalonia.FreeDesktop" />
      <package pattern="Avalonia.HarfBuzz" />
      <package pattern="Avalonia.iOS" />
      <package pattern="Avalonia.Native" />
      <package pattern="Avalonia.Remote.Protocol" />
      <package pattern="Avalonia.Skia" />
      <package pattern="Avalonia.Wayland" />
      <package pattern="Avalonia.Win32" />
    </packageSource>
    <packageSource key="lightstudio-lightplayer">
      <package pattern="Avalonia" />
      <package pattern="Avalonia.Android" />
      <package pattern="Avalonia.Browser" />
      <package pattern="Avalonia.FreeDesktop" />
      <package pattern="Avalonia.HarfBuzz" />
      <package pattern="Avalonia.iOS" />
      <package pattern="Avalonia.Native" />
      <package pattern="Avalonia.Remote.Protocol" />
      <package pattern="Avalonia.Skia" />
      <package pattern="Avalonia.Wayland" />
      <package pattern="Avalonia.Win32" />
      <package pattern="Jint" />
      <package pattern="LightStudio.AvaloniaStatic.Native" />
      <package pattern="LightStudio.GeoNames" />
      <package pattern="LightStudio.Fonts" />
    </packageSource>
  </packageSourceMapping>
</configuration>