{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightplayer.example/schemas/video-shader-package-v1.schema.json",
  "title": "Light Player video shader package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "author",
    "license",
    "licenseFile",
    "stage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,126}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "licenseFile": {
      "$ref": "#/$defs/relativeFile"
    },
    "stage": {
      "$ref": "#/$defs/relativeFile"
    }
  },
  "$defs": {
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  }
}
