<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<ProjectReference Include="..\LightStudio.MediaLibraryCore.Contracts\LightStudio.MediaLibraryCore.Contracts.csproj" />
		<ProjectReference Include="..\LightStudio.Logging\LightStudio.Logging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LightStudio.GeoNames" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Logging.TraceSource" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Strings\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Strings\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Include="$(LightStudioGeoNamesDatabase)" LogicalName="LightStudio.MediaLibraryCore.GeoNames.geonames.bin.gz" />
	</ItemGroup>

	<Target Name="RequireGeoNamesDatabase" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(LightStudioGeoNamesDatabase)' == '' Or !Exists('$(LightStudioGeoNamesDatabase)')" Text="The LightStudio.GeoNames package did not supply its photo location database. Restore the package before building." />
	</Target>
</Project>
