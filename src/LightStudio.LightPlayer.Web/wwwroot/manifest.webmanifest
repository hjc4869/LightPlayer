{
  "id": "/",
  "name": "Light Player",
  "short_name": "Light Player",
  "description": "A music and video player for your own library, on your own devices.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#181c20",
  "theme_color": "#181c20",
  "categories": ["music", "entertainment", "multimedia"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Songs",
      "url": "/#songs",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Albums",
      "url": "/#albums",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Videos",
      "url": "/#videos",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Playlists",
      "url": "/#playlists",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Audio file",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/flac": [".flac"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/aiff": [".aiff", ".aif"],
        "audio/x-ms-wma": [".wma"],
        "audio/x-ape": [".ape"],
        "audio/x-tta": [".tta"],
        "audio/x-tak": [".tak"],
        "application/x-cue": [".cue"]
      }
    },
    {
      "action": "/",
      "name": "Video file",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "video/x-matroska": [".mkv"],
        "video/mp4": [".mp4", ".m4v"],
        "video/quicktime": [".mov"],
        "video/x-msvideo": [".avi"],
        "video/webm": [".webm"],
        "video/mp2t": [".ts", ".m2ts", ".mts"],
        "video/mpeg": [".mpg", ".mpeg"],
        "video/ogg": [".ogv"],
        "video/x-flv": [".flv"],
        "video/x-ms-wmv": [".wmv"],
        "video/x-ms-asf": [".asf"],
        "video/3gpp": [".3gp"],
        "video/3gpp2": [".3g2"]
      }
    },
    {
      "action": "/",
      "name": "Image file",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "image/jpeg": [".jpg", ".jpeg", ".jpe", ".jfif"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "image/avif": [".avif"],
        "image/heic": [".heic"],
        "image/heif": [".heif", ".hif"],
        "image/jxl": [".jxl"],
        "image/jxr": [".jxr"],
        "image/vnd.ms-photo": [".wdp", ".hdp"],
        "image/x-adobe-dng": [".dng"],
        "image/bmp": [".bmp", ".dib"],
        "image/gif": [".gif"],
        "image/tiff": [".tif", ".tiff"],
        "image/x-portable-pixmap": [".ppm"],
        "image/x-portable-graymap": [".pgm"],
        "image/x-portable-anymap": [".pnm"],
        "image/x-targa": [".tga"],
        "image/x-exr": [".exr"],
        "image/vnd.radiance": [".hdr"]
      }
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": ["audio/*", "video/*", "image/*"]
        }
      ]
    }
  }
}
