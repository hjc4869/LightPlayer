<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LightStudio.LightPlayer.App"
             xmlns:local="using:LightStudio.LightPlayer"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             RequestedThemeVariant="Default"
             Name="{x:Static strings:Resources.About_ProductName}">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static strings:Resources.Common_About}" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palette.axaml" />
                <ResourceInclude Source="/Themes/Icons.axaml" />
                <ResourceInclude Source="/Themes/ContextFlyouts.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/light-logo.ico" />
        </Style>
        <StyleInclude Source="/Themes/ControlStyles.axaml" />
        <StyleInclude Source="/Themes/AppleControls.axaml" />
    </Application.Styles>
</Application>