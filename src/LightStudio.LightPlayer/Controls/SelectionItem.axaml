<ContentControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="using:LightStudio.LightPlayer.Controls"
                xmlns:models="using:LightStudio.LightPlayer.Models"
                x:Class="LightStudio.LightPlayer.Controls.SelectionItem"
                x:DataType="models:SelectionItemModel"
                Focusable="{Binding IsSelectionMode}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
    <ContentControl.Styles>
        <Style Selector="controls|SelectionItem.tile /template/ CheckBox#SelectionCheck">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style Selector="controls|SelectionItem.tile /template/ CheckBox#SelectionCheck:unchecked /template/ Border#NormalRectangle, controls|SelectionItem.tile /template/ CheckBox#SelectionCheck:unchecked /template/ Border#MacCheckBoxWell">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
        </Style>
    </ContentControl.Styles>
    <ContentControl.Template>
        <ControlTemplate>
            <Border CornerRadius="4" Background="Transparent">
                <Grid ColumnDefinitions="Auto,*">
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      IsHitTestVisible="{Binding !IsSelectionMode}" />
                    <CheckBox x:Name="SelectionCheck"
                              Grid.Column="0"
                              IsVisible="{Binding IsSelectionMode}"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              IsHitTestVisible="False"
                              Focusable="False"
                              Width="20"
                              MinWidth="0"
                              MinHeight="32"
                              Padding="0"
                              Margin="4,0,8,0"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>