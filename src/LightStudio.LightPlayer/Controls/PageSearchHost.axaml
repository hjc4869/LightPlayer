<ContentControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="using:LightStudio.LightPlayer.Controls"
                x:Class="LightStudio.LightPlayer.Controls.PageSearchHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
    <ContentControl.Template>
        <ControlTemplate>
            <Grid>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                <controls:PageSearchHighlightLayer x:Name="PART_Highlights"
                                                  IsHitTestVisible="False" ClipToBounds="True" />
                <Panel x:Name="PART_SearchOverlay" Margin="8" VerticalAlignment="Top">
                    <controls:PageSearchBar x:Name="PART_SearchBar"
                                            DataContext="{TemplateBinding Search}"
                                            Width="300"
                                            MaxWidth="{Binding #PART_SearchOverlay.Bounds.Width}"
                                            HorizontalAlignment="Right" />
                </Panel>
            </Grid>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>