<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="48"
             x:Class="LightStudio.LightPlayer.Controls.TrackRow"
             x:DataType="models:TrackRowModel">
    <UserControl.Styles>
        <!-- Grayed row + inline play/append actions revealed when the pointer is over the row. -->
        <Style Selector="Border.rowHover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.rowActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.rowHover:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        </Style>
        <Style Selector="Border.rowHover:pointerover StackPanel.rowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Now-playing track: highlight the title with the accent color and bold weight. -->
        <Style Selector="TextBlock.trackTitle">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.trackTitle.playing">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Border Classes="rowHover"
            Classes.folder="{Binding IsFolder}"
            CornerRadius="4"
            Padding="12,0,12,0"
            Focusable="{Binding IsFolder}"
            KeyDown="OnRowKeyDown"
            Tapped="OnTapped"
            DoubleTapped="OnDoubleTapped">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="{Binding Selection_Select, Source={x:Static strings:LocalizedStrings.Instance}}"
                          Command="{Binding Selection.EnterCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanSelect}" />
                <Separator IsVisible="{Binding CanSelect}" />
                <MenuItem Header="{Binding Common_Open, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding OpenMusicFolderCommand}" IsVisible="{Binding IsFolder}" />
                <MenuItem Header="{Binding Common_Play, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding FolderPlayCommand}" IsVisible="{Binding IsFolder}" />
                <MenuItem Header="{Binding Common_Play, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding PlayCommand}" IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_PlayNext, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding FolderPlayNextCommand}" IsVisible="{Binding IsFolder}" />
                <MenuItem Header="{Binding Common_PlayNext, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding PlayNextCommand}" IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_AddToQueue, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding FolderAddToQueueCommand}" IsVisible="{Binding IsFolder}" />
                <MenuItem Header="{Binding Common_AddToQueue, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding AddToQueueCommand}" IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_AddToPlaylist, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding FolderAddToPlaylistCommand}" IsVisible="{Binding IsFolder}" />
                <MenuItem Header="{Binding Common_AddToPlaylist, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding AddToPlaylistCommand}" IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_RemoveFromPlaylist, Source={x:Static strings:LocalizedStrings.Instance}}"
                          Command="{Binding RemoveFromPlaylistCommand}"
                          IsVisible="{Binding IsPlaylistItem}" />
                <Separator IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_GoToAlbum, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding OpenAlbumCommand}" IsVisible="{Binding CanOpenAlbum}" />
                <MenuItem Header="{Binding Common_GoToArtist, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding OpenArtistCommand}" IsVisible="{Binding CanOpenArtist}" />
                <Separator IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_Properties, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding PropertiesCommand}" IsVisible="{Binding !IsFolder}" />
                <MenuItem Header="{Binding Common_OpenContainingFolder, Source={x:Static strings:LocalizedStrings.Instance}}"
                          Command="{Binding OpenFolderCommand}"
                          IsVisible="{Binding CanOpenContainingFolder}" />
            </MenuFlyout>
        </Border.ContextFlyout>

        <Panel>
            <!-- Wide / medium layout: a single columnar row. The Album, Year and Genre
                 columns collapse from right to left as the row narrows (see code-behind). -->
            <Grid x:Name="WideRoot"
                  Height="48"
                  VerticalAlignment="Center"
                  ColumnDefinitions="1.4*,1*,1*,70,90,60">
                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                    <Viewbox x:Name="WideFolderIcon" DockPanel.Dock="Right"
                             IsVisible="{Binding IsFolder}" Width="18" Height="18"
                             Margin="8,0,0,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AppSecondaryTextBrush}" />
                    </Viewbox>
                    <StackPanel x:Name="RowActions"
                                Classes="rowActions"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="miniIcon"
                                Command="{Binding RowPlayCommand}"
                                ToolTip.Tip="{Binding Common_Play, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource IconPlay}"
                                      Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                        </Button>
                        <controls:AddToQueueButton Classes="miniIcon"
                                IconSize="15"
                                Command="{Binding RowAddToQueueCommand}"
                                ToolTip.Tip="{Binding Common_AddToQueue, Source={x:Static strings:LocalizedStrings.Instance}}" />
                    </StackPanel>
                    <TextBlock Classes="trackTitle"
                               Classes.playing="{Binding IsPlaying}"
                               Text="{Binding Title}"
                               ToolTip.Tip="{Binding Title}"
                               VerticalAlignment="Center"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="ArtistText"
                           Grid.Column="1"
                           Text="{Binding Artist}"
                           ToolTip.Tip="{Binding Artist}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock x:Name="AlbumText"
                           Grid.Column="2"
                           Text="{Binding Album}"
                           ToolTip.Tip="{Binding Album}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock x:Name="YearText"
                           Grid.Column="3"
                           Text="{Binding Year}"
                           ToolTip.Tip="{Binding Year}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MaxLines="1"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock x:Name="GenreText"
                           Grid.Column="4"
                           Text="{Binding Genre}"
                           ToolTip.Tip="{Binding Genre}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="5"
                           Text="{Binding Duration}"
                           ToolTip.Tip="{Binding Duration}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="13"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </Grid>

            <!-- Narrow layout: stack the title over a single "artist / album" line,
                 keeping the duration on the right. Shown below 650px. -->
            <Grid x:Name="NarrowRoot"
                  Height="60"
                  IsVisible="False"
                  VerticalAlignment="Center"
                  ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <controls:FixedLineTextBlock Classes="trackTitle"
                               Classes.playing="{Binding IsPlaying}"
                               Text="{Binding Title}"
                               ToolTip.Tip="{Binding Title}"
                               LineHeight="17"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis" />
                    <controls:FixedLineTextBlock Text="{Binding SubText}"
                               IsVisible="{Binding !IsFolder}"
                               ToolTip.Tip="{Binding SubText}"
                               Height="18"
                               FontSize="13"
                               LineHeight="16"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Classes="rowActions"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="8,0"
                            VerticalAlignment="Center">
                    <Button Classes="miniIcon"
                            Command="{Binding RowPlayCommand}"
                            ToolTip.Tip="{Binding Common_Play, Source={x:Static strings:LocalizedStrings.Instance}}">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconPlay}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                    </Button>
                    <controls:AddToQueueButton Classes="miniIcon"
                            IconSize="15"
                            Command="{Binding RowAddToQueueCommand}"
                            ToolTip.Tip="{Binding Common_AddToQueue, Source={x:Static strings:LocalizedStrings.Instance}}" />
                </StackPanel>
                <Viewbox x:Name="NarrowFolderIcon" Grid.Column="3"
                         IsVisible="{Binding IsFolder}" Width="18" Height="18"
                         Margin="8,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AppSecondaryTextBrush}" />
                </Viewbox>
                <TextBlock Grid.Column="3" IsVisible="{Binding !IsFolder}"
                           Text="{Binding Duration}"
                           ToolTip.Tip="{Binding Duration}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </Grid>
        </Panel>
    </Border>
</UserControl>
