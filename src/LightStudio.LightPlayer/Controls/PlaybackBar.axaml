<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:conv="using:LightStudio.LightPlayer.Converters"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="80"
             x:Class="LightStudio.LightPlayer.Controls.PlaybackBar"
             x:DataType="vm:PlaybackBarViewModel"
             SizeChanged="OnSizeChanged">
    <UserControl.Styles>
        <!-- Flat now-playing button: no Fluent chrome, subtle hover only. -->
        <Style Selector="Button.trackInfo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.trackInfo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.trackInfo:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border#BarSurface">
            <Setter Property="Background" Value="{DynamicResource AppPlaybackBarSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppChromeDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Height" Value="80" />
        </Style>
        <!-- Hosted by a material of the shell's own; the shell supplies the surface. -->
        <Style Selector="controls|PlaybackBar.floating Border#BarSurface">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="72" />
        </Style>
    </UserControl.Styles>
    <Border x:Name="BarSurface">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="24,0" VerticalAlignment="Center">
            <!-- Album art (left) -->
            <Button Grid.Column="0"
                    Classes="trackInfo"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding PlaybackBar_OpenNowPlaying, Source={x:Static strings:LocalizedStrings.Instance}}"
                    Command="{Binding OpenNowPlayingCommand}">
                <controls:MediaThumbnail Width="60"
                                         Height="60"
                                         CornerRadius="6"
                                         Source="{Binding AlbumImage}"
                                         PlaceholderKind="Album" />
            </Button>

            <!-- Track metadata (top) above the progress slider (bottom) -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,*"
                  Margin="14,0,8,0">
                <Button Grid.Row="0"
                        Classes="trackInfo"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,2,6,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalAlignment="Bottom"
                        ToolTip.Tip="{Binding PlaybackBar_OpenNowPlaying, Source={x:Static strings:LocalizedStrings.Instance}}"
                        Command="{Binding OpenNowPlayingCommand}">
                    <TextBlock Text="{Binding NowPlayingLine}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" />
                </Button>
                <Grid.Resources>
                    <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double> 
                    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double> 
                    <x:Double x:Key="SliderVerticalThumbWidth">10</x:Double> 
                    <x:Double x:Key="SliderVerticalThumbHeight">10</x:Double> 
                </Grid.Resources>
                <controls:PlaybackProgressSlider Grid.Row="1"
                        x:Name="ProgressSlider"
                        VerticalAlignment="Top"
                        Height="22"
                        Margin="6,0"
                        Minimum="0"
                        Maximum="{Binding DurationMs}"
                        Value="{Binding PositionMs, Mode=TwoWay}"
                        IsEnabled="{Binding HasItem}" />
            </Grid>

            <!-- Remaining time -->
            <TextBlock Grid.Column="2"
                       Text="{Binding RemainingText}"
                       VerticalAlignment="Center"
                       MinWidth="52"
                       TextAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />

            <!-- Controls (right) -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                    <Button x:Name="AudioSeparationButton" Classes="icon" IsVisible="{Binding CanSeparateAudio}"
                            IsEnabled="{Binding HasItem}"
                            Click="OnAudioSeparationClick"
                            ToolTip.Tip="{Binding AudioSeparation_Title, Source={x:Static strings:LocalizedStrings.Instance}}">
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource IconAudioSeparation}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                        <services:NativeContextMenu.Menu>
                            <MenuFlyout Placement="Top" />
                        </services:NativeContextMenu.Menu>
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{Binding Common_AddToPlaylist, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsVisible="{Binding ShowAllControls, RelativeSource={RelativeSource AncestorType=controls:PlaybackBar}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding AddToPlaylistCommand}">
                        <Viewbox Width="22" Height="22">
                            <Path Data="{StaticResource IconAdd}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding PlaybackBar_Like, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsVisible="{Binding ShowAllControls, RelativeSource={RelativeSource AncestorType=controls:PlaybackBar}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding ToggleFavoriteCommand}">
                        <Panel>
                            <Viewbox Width="22" Height="22" IsVisible="{Binding !IsFavorite}">
                                <Path Data="{StaticResource IconHeartOutline}"
                                      Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                            <Viewbox Width="22" Height="22" IsVisible="{Binding IsFavorite}">
                                <Path Data="{StaticResource IconHeartFilled}"
                                      Fill="{DynamicResource AppFavoriteBrush}" />
                            </Viewbox>
                        </Panel>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding PlaybackBar_Volume, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsVisible="{Binding ShowAllControls, RelativeSource={RelativeSource AncestorType=controls:PlaybackBar}}">
                        <Viewbox Width="22" Height="22">
                            <Path Data="{Binding VolumeIconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Slider Width="200"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Volume, Mode=TwoWay}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding PlaybackBar_Previous, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding PreviousCommand}">
                        <Viewbox Width="24" Height="24">
                            <Path Data="{StaticResource IconPrevious}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding PlaybackBar_PlayPause, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding PlayPauseCommand}">
                        <Panel Width="26" Height="26">
                            <Viewbox IsVisible="{Binding !IsInitializing}">
                                <Path Data="{Binding PlayPauseIconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                      Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                            <controls:LoadingSpinner Width="22" Height="22"
                                                     Stroke="{DynamicResource AppPrimaryTextBrush}"
                                                     IsVisible="{Binding IsInitializing}" />
                        </Panel>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding PlaybackBar_Next, Source={x:Static strings:LocalizedStrings.Instance}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding NextCommand}">
                        <Viewbox Width="24" Height="24">
                            <Path Data="{StaticResource IconNext}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                    </Button>

                    <Button Classes="icon"
                            ToolTip.Tip="{Binding ModeLabel}"
                            IsVisible="{Binding ShowAllControls, RelativeSource={RelativeSource AncestorType=controls:PlaybackBar}}"
                            IsEnabled="{Binding HasItem}"
                            Command="{Binding CycleModeCommand}">
                        <Viewbox Width="22" Height="22">
                            <Path Data="{Binding ModeIconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                  Fill="{DynamicResource AppPrimaryTextBrush}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
        </Grid>
    </Border>
</UserControl>
