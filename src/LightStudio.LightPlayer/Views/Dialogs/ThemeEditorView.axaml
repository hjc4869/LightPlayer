<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Dialogs"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             mc:Ignorable="d"
             d:DesignWidth="460"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Dialogs.ThemeEditorView"
             x:DataType="vm:ThemeEditorViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource AppFavoriteBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryTextBrush}"
                       Margin="0,0,0,12" />

            <!-- Footer actions -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,12,0,0">
                <Button Content="{Binding Common_Cancel, Source={x:Static strings:LocalizedStrings.Instance}}"
                        Command="{Binding CancelCommand}" />
                <Button Classes="accent"
                        Padding="16,8"
                        Content="{Binding Common_Save, Source={x:Static strings:LocalizedStrings.Instance}}"
                        IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,10,0,0"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppFavoriteBrush}"
                       IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <!-- Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ThemeEditor_NameLabel, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                 PlaceholderText="{Binding ThemeEditor_NameWatermark, Source={x:Static strings:LocalizedStrings.Instance}}" />
                    </StackPanel>

                    <!-- Variant -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ThemeEditor_VariantLabel, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <RadioButton GroupName="ThemeVariant"
                                         Content="{Binding Common_ThemeLight, Source={x:Static strings:LocalizedStrings.Instance}}"
                                         IsEnabled="{Binding CanChangeVariant}"
                                         IsChecked="{Binding IsLightVariant, Mode=TwoWay}" />
                            <RadioButton GroupName="ThemeVariant"
                                         Content="{Binding Common_ThemeDark, Source={x:Static strings:LocalizedStrings.Instance}}"
                                         IsEnabled="{Binding CanChangeVariant}"
                                         IsChecked="{Binding IsDarkVariant, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThemeEditor_VariantLockedHint, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   IsVisible="{Binding !CanChangeVariant}" />
                    </StackPanel>

                    <!-- Base on -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ThemeEditor_BaseOnLabel, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding BaseThemeOptions}"
                                  SelectedItem="{Binding SelectedBaseTheme, Mode=TwoWay}"
                                  PlaceholderText="{Binding ThemeEditor_BaseOnPlaceholder, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ColorTheme">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Live preview -->
                    <Border CornerRadius="8"
                            Height="96"
                            Background="{Binding PreviewPageBackgroundBrush}"
                            BorderBrush="{Binding PreviewDividerBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="34,*" Margin="6">
                            <Border Grid.Column="0"
                                    CornerRadius="5"
                                    Background="{Binding PreviewNavBackgroundBrush}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                    <Ellipse Width="10" Height="10" Fill="{Binding PreviewAccentBrush}" />
                                    <Border Width="12" Height="3" CornerRadius="2" Background="{Binding PreviewSecondaryTextBrush}" />
                                    <Border Width="12" Height="3" CornerRadius="2" Background="{Binding PreviewSecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Margin="6,0,0,0"
                                    CornerRadius="5"
                                    Background="{Binding PreviewPanelBackgroundBrush}"
                                    Padding="10">
                                <StackPanel VerticalAlignment="Center" Spacing="7">
                                    <Border Width="60" Height="10" CornerRadius="3" HorizontalAlignment="Left" Background="{Binding PreviewAccentBrush}" />
                                    <Border Width="150" Height="6" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding PreviewPrimaryTextBrush}" />
                                    <Border Width="110" Height="6" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding PreviewSecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Editable colors -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ThemeEditor_ColorsLabel, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeColorFieldViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                        <Border Grid.Column="1"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="5"
                                                Margin="8,0"
                                                Background="{Binding Preview}"
                                                BorderBrush="{DynamicResource AppDividerBrush}"
                                                BorderThickness="1" />
                                        <TextBox Grid.Column="2"
                                                 Width="120"
                                                 Classes.invalid="{Binding !IsValid}"
                                                 Text="{Binding HexText, Mode=TwoWay}"
                                                 FontFamily="Consolas,Menlo,monospace" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Inline overwrite confirmation (avoids nested dialogs on mobile) -->
        <Border IsVisible="{Binding IsOverwritePromptVisible}"
                Background="#99000000"
                CornerRadius="6">
            <Border MaxWidth="320"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ThemeEditor_OverwriteTitle, Source={x:Static strings:LocalizedStrings.Instance}}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" />
                    <TextBlock Text="{Binding OverwriteMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Common_Cancel, Source={x:Static strings:LocalizedStrings.Instance}}"
                                Command="{Binding CancelOverwriteCommand}" />
                        <Button Classes="accent"
                                Padding="16,8"
                                Content="{Binding ThemeEditor_OverwriteConfirm, Source={x:Static strings:LocalizedStrings.Instance}}"
                                Command="{Binding ConfirmOverwriteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
