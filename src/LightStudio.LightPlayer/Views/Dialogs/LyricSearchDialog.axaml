<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="using:LightStudio.LightPlayer.Strings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Dialogs"
        xmlns:dialogs="using:LightStudio.LightPlayer.Views.Dialogs"
        mc:Ignorable="d"
        d:DesignWidth="400"
        d:DesignHeight="540"
        x:Class="LightStudio.LightPlayer.Views.Dialogs.LyricSearchDialog"
        x:DataType="vm:LyricSearchDialogViewModel"
        Width="400"
        Height="560"
        Padding="18"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding NowPlaying_SearchLyrics, Source={x:Static strings:LocalizedStrings.Instance}}">
    <dialogs:LyricSearchView />
</Window>
