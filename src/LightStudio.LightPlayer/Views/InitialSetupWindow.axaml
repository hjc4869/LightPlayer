<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightStudio.LightPlayer.ViewModels"
        xmlns:views="using:LightStudio.LightPlayer.Views"
        xmlns:strings="using:LightStudio.LightPlayer.Strings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="720"
        x:Class="LightStudio.LightPlayer.Views.InitialSetupWindow"
        x:DataType="vm:InitialSetupViewModel"
        Title="{Binding InitialSetup_Title, Source={x:Static strings:LocalizedStrings.Instance}}"
        Width="840"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <views:InitialSetupView />
</Window>
