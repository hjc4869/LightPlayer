<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="360"
             x:Class="LightStudio.LightPlayer.Views.Pages.SampleRateSettingsSectionView"
             x:DataType="vm:SampleRateSettingsSectionViewModel">
    <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" Spacing="10">
        <StackPanel Spacing="4" Margin="0,0,0,4" IsVisible="{Binding ShowHeader}">
            <TextBlock Text="{Binding SampleRateSettings_Title, Source={x:Static strings:LocalizedStrings.Instance}}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryTextBrush}" />
        </StackPanel>

        <Border Classes="settingsGroup"
            Classes.joinedAbove="{Binding !ShowHeader}">
            <StackPanel>
        <Border Classes="settingsDivider" IsVisible="{Binding !ShowHeader}" />
        <controls:SettingRow Header="{Binding SampleRateSettings_AlwaysResampleHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                             IsGrouped="True">
            <controls:SettingRow.ActionContent>
                <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding AlwaysResample, Mode=TwoWay}" />
            </controls:SettingRow.ActionContent>
        </controls:SettingRow>

        <controls:SettingRow Header="{Binding SampleRateSettings_PreferredRateHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                             IsGrouped="True"
                             HasTopDivider="True">
            <controls:SettingRow.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </controls:SettingRow.Styles>
            <controls:SettingRow.ActionContent>
                <ComboBox Width="150"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SampleRateOption">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingRow.ActionContent>
        </controls:SettingRow>

        <controls:SettingRow Header="{Binding SampleRateSettings_SystemRateHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                             IsGrouped="True"
                             HasTopDivider="True">
            <controls:SettingRow.ActionContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemSampleRate}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    <Button Classes="icon"
                            ToolTip.Tip="{Binding Common_Refresh, Source={x:Static strings:LocalizedStrings.Instance}}"
                            Command="{Binding RefreshSystemSampleRateCommand}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{DynamicResource AppSecondaryTextBrush}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </controls:SettingRow.ActionContent>
        </controls:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding SampleRateSettings_NextTrackPrompt, Source={x:Static strings:LocalizedStrings.Instance}}"
                   IsVisible="{Binding NextTrackPromptVisible}"
                   FontSize="12"
                   Margin="2,-2,2,2"
                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
    </StackPanel>
</UserControl>
