<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="180"
             x:Class="LightStudio.LightPlayer.Views.Pages.AppearancePreferencesView"
             x:DataType="vm:AppearancePreferencesViewModel">
    <Border Classes="settingsGroup"
            MaxWidth="680"
            HorizontalAlignment="Stretch">
        <StackPanel>
            <controls:SettingRow IsGrouped="True"
                                 Header="{Binding DefaultPageSettings_StartupPageHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 ActionWidth="110">
                <controls:SettingRow.ActionContent>
                    <ComboBox ItemsSource="{Binding DefaultPage.PageOptions}"
                              SelectedItem="{Binding DefaultPage.SelectedPage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DefaultPageOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>

            <controls:SettingRow IsGrouped="True"
                                 HasTopDivider="True"
                                 Header="{Binding LanguageSettings_InterfaceLanguageHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 ActionWidth="110">
                <controls:SettingRow.ActionContent>
                    <ComboBox ItemsSource="{Binding Language.LanguageOptions}"
                              SelectedItem="{Binding Language.SelectedLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>

            <controls:SettingRow IsGrouped="True"
                                 HasTopDivider="True"
                                 IsVisible="{Binding ShowBackdropStyle}"
                                 Header="{Binding ThemeColor_BackdropHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 ActionWidth="110">
                <controls:SettingRow.ActionContent>
                    <ComboBox x:Name="BackdropStylePicker"
                              ItemsSource="{Binding BackdropStyleOptions}"
                              SelectedIndex="{Binding BackdropStyleIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding ThemeColor_BackdropHeader, Source={x:Static strings:LocalizedStrings.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackdropStyleOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>

            <controls:SettingRow IsGrouped="True"
                                 HasTopDivider="True"
                                 IsVisible="{x:Static services:PlatformServices.SupportsWaylandSettings}"
                                 Header="{Binding WaylandSettings_EnableHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 ActionWidth="110">
                <controls:SettingRow.ActionContent>
                    <ComboBox ItemsSource="{Binding Wayland.ModeOptions}"
                              SelectedItem="{Binding Wayland.SelectedMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WaylandModeOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>

            <controls:SettingRow IsGrouped="True"
                                 HasTopDivider="True"
                                 IsVisible="{Binding ShowLiquidGlassFrost}"
                                 Header="{Binding ThemeColor_GlassFrostHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 ActionWidth="200">
                <controls:SettingRow.ActionContent>
                    <!-- Overlapping panes mark the ends: clear glass shows the pane behind it, frosted glass hides it. -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8"
                          VerticalAlignment="Center"
                          controls:SettingRowPanel.StacksGroup="False">
                        <Panel Width="20" Height="16" VerticalAlignment="Center">
                            <Path Data="M4,1H10A3,3 0 0 1 13,4V8A3,3 0 0 1 10,11H4A3,3 0 0 1 1,8V4A3,3 0 0 1 4,1Z"
                                  Stroke="{DynamicResource AppSecondaryTextBrush}"
                                  StrokeThickness="1.2" />
                            <Path Data="M9,5H16A3,3 0 0 1 19,8V12A3,3 0 0 1 16,15H9A3,3 0 0 1 6,12V8A3,3 0 0 1 9,5Z"
                                  Stroke="{DynamicResource AppSecondaryTextBrush}"
                                  StrokeThickness="1.2" />
                        </Panel>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.25"
                                VerticalAlignment="Center"
                                Value="{Binding LiquidGlassFrost, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding ThemeColor_GlassFrostHeader, Source={x:Static strings:LocalizedStrings.Instance}}" />
                        <Panel Grid.Column="2" Width="20" Height="16" VerticalAlignment="Center">
                            <Path Data="M4,1H10A3,3 0 0 1 13,4V8A3,3 0 0 1 10,11H4A3,3 0 0 1 1,8V4A3,3 0 0 1 4,1Z"
                                  Stroke="{DynamicResource AppSecondaryTextBrush}"
                                  StrokeThickness="1.2" />
                            <Path Data="M9,5H16A3,3 0 0 1 19,8V12A3,3 0 0 1 16,15H9A3,3 0 0 1 6,12V8A3,3 0 0 1 9,5Z"
                                  Fill="{DynamicResource AppSecondaryTextBrush}"
                                  Stroke="{DynamicResource AppSecondaryTextBrush}"
                                  StrokeThickness="1.2" />
                        </Panel>
                    </Grid>
                </controls:SettingRow.ActionContent>
            </controls:SettingRow>
        </StackPanel>
    </Border>
</UserControl>