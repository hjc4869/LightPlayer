<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
    <Panel>
        <!-- Tiles (albums / artists) -->
        <ScrollViewer IsVisible="{Binding IsTiles}" Margin="32">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:UniformTileGrid MinItemWidth="130"
                                                  MinItemHeight="160"
                                                  MinColumnSpacing="6"
                                                  MinRowSpacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryTileModel">
                        <Viewbox>
                            <controls:LibraryTile />
                        </Viewbox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Tracks (songs) -->
        <Grid IsVisible="{Binding IsTracks}" RowDefinitions="Auto,*" Margin="12,0,12,12">
            <Grid Grid.Row="0"
                  Height="32"
                  Margin="12,0"
                  ColumnDefinitions="1.4*,1*,1*,70,90,60">
                <TextBlock Grid.Column="0" Text="{Binding Common_ColumnTitle, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Common_ColumnArtist, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Common_ColumnAlbum, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding Common_ColumnYear, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="4" Text="{Binding Common_ColumnGenre, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBlock Grid.Column="5" Text="{Binding Common_ColumnLength, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackRowModel">
                            <controls:TrackRow />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Settings -->
        <ScrollViewer IsVisible="{Binding IsSettings}" Padding="36,8,36,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{Binding LibrarySettings_Title, Source={x:Static strings:LocalizedStrings.Instance}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                <controls:SettingRow Header="{Binding Placeholder_AddAFolderHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding Placeholder_AddFolderDescription, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <controls:SettingRow.ActionContent>
                        <Button Content="{Binding LibrarySettings_AddFolder, Source={x:Static strings:LocalizedStrings.Instance}}" />
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:LibraryFolderModel">
                            <controls:SettingRow Header="{Binding Name}" Description="{Binding Path}">
                                <controls:SettingRow.ActionContent>
                                    <Button Classes="icon" ToolTip.Tip="{Binding Placeholder_RemoveThisFolder, Source={x:Static strings:LocalizedStrings.Instance}}">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource IconClose}"
                                                  Fill="{DynamicResource AppSecondaryTextBrush}" />
                                        </Viewbox>
                                    </Button>
                                </controls:SettingRow.ActionContent>
                            </controls:SettingRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Placeholder_Appearance, Source={x:Static strings:LocalizedStrings.Instance}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,18,0,10"
                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                <controls:SettingRow Header="{Binding ThemeSettings_Title, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding Placeholder_ThemeDescription, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <controls:SettingRow.ActionContent>
                        <ComboBox SelectedIndex="0" MinWidth="140">
                            <ComboBoxItem Content="{Binding Common_ThemeSystem, Source={x:Static strings:LocalizedStrings.Instance}}" />
                            <ComboBoxItem Content="{Binding Common_ThemeLight, Source={x:Static strings:LocalizedStrings.Instance}}" />
                            <ComboBoxItem Content="{Binding Common_ThemeDark, Source={x:Static strings:LocalizedStrings.Instance}}" />
                        </ComboBox>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <controls:EmptyState IsVisible="{Binding IsEmpty}"
                             Header="{Binding EmptyHeader}"
                             Description="{Binding EmptyDescription}" />

        <!-- Generic placeholder -->
        <Grid IsVisible="{Binding IsPlaceholder}" RowDefinitions="Auto,Auto,*" Margin="36" RowSpacing="18">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}" />
                <TextBlock Text="{Binding Kind}" FontSize="14" Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6" Padding="10,6">
                    <TextBlock Text="{Binding RouteId}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}" />
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource AppPanelBackgroundBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
                <TextBlock Text="{Binding Placeholder_PlaceholderRoute, Source={x:Static strings:LocalizedStrings.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Panel>
</UserControl>