<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             xmlns:views="using:LightStudio.LightPlayer.Views.Pages"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.PlaybackSettingsSectionView"
             x:DataType="vm:PlaybackSettingsSectionViewModel">
    <!-- The inset lives on the content, not the scroll viewer, so the scroll bar stays at the pane edge. -->
    <ScrollViewer>
        <StackPanel Margin="{Binding ContentMargin}"
                    Spacing="10">
            <StackPanel>
                <ContentControl Content="{Binding AudioSettings}"
                                IsVisible="{x:Static services:PlatformServices.SupportsAudioOutputSettings}" />
                <ContentControl Content="{Binding SampleRate}"
                                IsVisible="{x:Static services:PlatformServices.SupportsSampleRateSettings}" />
                <Panel IsVisible="{Binding HasAudioSeparation}">
                    <views:AudioSeparationSettingsView DataContext="{Binding AudioSeparation}" />
                </Panel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
