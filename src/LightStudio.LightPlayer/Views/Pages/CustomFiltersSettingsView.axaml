<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             xmlns:views="using:LightStudio.LightPlayer.Views.Pages"
             x:Class="LightStudio.LightPlayer.Views.Pages.CustomFiltersSettingsView"
             x:DataType="vm:VideoSettingsSectionViewModel">
      <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12"
          Margin="0,0,0,4">
        <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="settingsTitle" Text="{Binding CustomFiltersHeader}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="settingsSubtitle" Text="{Binding CustomFiltersDescription}"
                       TextWrapping="Wrap" />
            <Button Classes="link noteLink"
                    HorizontalAlignment="Left"
                    FontSize="13"
                    Content="{Binding FindShaderPackagesText}"
                    Click="OnFindShaderPackagesClick" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="icon"
                Margin="0,0,18,0"
                VerticalAlignment="Center"
                IsVisible="{Binding CanImportShaderPackages}"
                ToolTip.Tip="{Binding ImportFilterText}"
                Click="OnImportShaderPackageClick">
            <Viewbox Width="16" Height="16">
                <Path Data="{StaticResource IconAdd}"
                      Fill="{DynamicResource AppPrimaryTextBrush}" />
            </Viewbox>
        </Button>
    </Grid>

    <TextBlock Classes="settingsCaption nudged" Text="{Binding ShaderPackageStatus}"
               IsVisible="{Binding HasShaderPackageStatus}"
               Margin="2,-2,2,2"
               TextWrapping="Wrap" />

    <TextBlock Classes="settingsNote nudged" Text="{Binding NoCustomFiltersText}"
               IsVisible="{Binding !HasShaderPackages}"
               Margin="2,6,2,0"
               TextWrapping="Wrap" />

    <ItemsControl ItemsSource="{Binding ShaderPackages}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VideoShaderPackageRowViewModel">
                <Border Classes="settingsGroup"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <!-- The actions move below the filter's details in a narrow card. -->
                        <controls:SettingRowPanel Margin="16,12" ActionSpacing="10">
                            <TextBlock Text="{Binding DisplayName}"
                                       Classes="settingName"
                                       FontSize="{DynamicResource AppSettingNameFontSize}" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Description}"
                                           Classes="settingDescription"
                                           FontSize="{DynamicResource AppSettingDescriptionFontSize}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}"
                                           Classes="settingDescription"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding PriorityText}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <Button Classes="icon"
                                        ToolTip.Tip="{Binding MoveUpText}"
                                        Command="{Binding MoveUpCommand}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconChevronUp}"
                                              Fill="{DynamicResource AppSecondaryTextBrush}" />
                                    </Viewbox>
                                </Button>
                                <Button Classes="icon"
                                        ToolTip.Tip="{Binding MoveDownText}"
                                        Command="{Binding MoveDownCommand}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconChevronDown}"
                                              Fill="{DynamicResource AppSecondaryTextBrush}" />
                                    </Viewbox>
                                </Button>
                                <Button Classes="icon"
                                        ToolTip.Tip="{Binding DeleteText}"
                                        Command="{Binding RemoveCommand}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconDelete}"
                                              Fill="{DynamicResource AppSecondaryTextBrush}" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </controls:SettingRowPanel>

                        <Border Classes="settingsDivider" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="16,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EnabledText}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Border Classes="settingsDivider" />

                        <controls:SettingRowPanel Margin="16,8"
                                                  ActionSpacing="12"
                                                  ActionWidth="150"
                                                  ActionWidthScale="{DynamicResource AppSettingActionWidthScale}">
                            <TextBlock Text="{Binding MaximumResolutionText}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppPrimaryTextBrush}" />
                            <TextBlock Text="{Binding MaximumResolutionDescription}"
                                       Classes="settingDescription"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <controls:NumberEntry Minimum="0"
                                                  Maximum="{Binding MaximumResolutionLimit}"
                                                  Increment="120"
                                                  FormatString="0"
                                                  Number="{Binding MaximumSourceResolution, Mode=TwoWay}" />
                        </controls:SettingRowPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
</UserControl>
