<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:conv="using:LightStudio.LightPlayer.Converters"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             xmlns:lmr="using:LightMediaRenderer.Avalonia.Controls"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.SearchPageView"
             x:DataType="vm:SearchPageViewModel"
             lmr:FastImage.CachePool="{x:Static services:AlbumArtService.ThumbnailCache}">
    <UserControl.Resources>
        <!-- The query text alone; the field's surface, glyph, and clear button are drawn around it. -->
        <ControlTheme x:Key="SearchFieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel Name="PART_InnerDockPanel" Margin="{TemplateBinding Padding}" Background="Transparent" Cursor="IBeam">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                      IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                      AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                      BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                            <Panel>
                                <TextBlock Name="SearchPlaceholder"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               LineHeight="{TemplateBinding LineHeight}"
                                               LetterSpacing="{TemplateBinding LetterSpacing}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Panel>
                        </ScrollViewer>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover, ^:focus">
                <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
            </Style>
        </ControlTheme>

        <!-- A bare button surface; the page's styles give it its chip, glyph, or row appearance. -->
        <ControlTheme x:Key="SearchPlainButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="vm:SearchSectionViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="10,0" MinHeight="30">
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                <Button Grid.Column="1"
                        Classes="headerAction"
                        Command="{Binding ShowAllCommand}"
                        IsVisible="{Binding HasMore}">
                    <TextBlock Text="{Binding Home_ViewAll, Source={x:Static strings:LocalizedStrings.Instance}}"
                               FontSize="13"
                               Foreground="{DynamicResource AppAccentBrush}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Query field: a panel-colored surface whose outline takes the accent while it holds focus. -->
        <Style Selector="Border#SearchField">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        </Style>
        <Style Selector="Border#SearchField:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Viewbox#SearchGlyph">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="Viewbox#SearchGlyph > Path, Button#ClearButton Path">
            <Setter Property="Fill" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="Button#ClearButton">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button#ClearButton:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>

        <!-- Filter chips: outlined capsules, filled with the selection color while chosen. -->
        <Style Selector="Button.searchChip">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.searchChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        </Style>
        <Style Selector="Button.searchChip.selected">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSelectionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.searchChip TextBlock.chipCount">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.searchChip.empty:not(.selected) TextBlock.chipLabel">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.searchChip Path">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <!-- A field without room for the chips beside the filter's label keeps only the filter's glyph. -->
        <Style Selector="Button#SourceFilterButton.compact TextBlock#SourceFilterText">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button.headerAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.headerAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        </Style>

        <!-- Recent searches: full-width rows with a hover fill. -->
        <Style Selector="Button.recentSearch">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.recentSearch:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        </Style>

        <!-- Videos and photos follow the video library: a grid of preview tiles when there is room for
             legible captions, a list of rows when there is not. -->
        <Style Selector="ItemsControl.mediaResults">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <controls:UniformTileGrid MinItemWidth="270"
                                              MinItemHeight="165"
                                              MinColumnSpacing="4"
                                              MinRowSpacing="4" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="models:VideoTileModel">
                    <Viewbox>
                        <controls:VideoTile />
                    </Viewbox>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.mediaResults.list">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="models:VideoTileModel">
                    <controls:VideoListRow />
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Apple style: a capsule field with the accent focus ring, and filled capsule chips that
             take the accent while chosen. -->
        <Style Selector=":is(TopLevel).appleControls">
            <Style Selector="^ Border#SearchField">
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="{DynamicResource MacFieldFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MacFieldBorder}" />
            </Style>
            <Style Selector="^ Border#SearchField:focus-within">
                <Setter Property="BorderBrush" Value="{DynamicResource MacFieldBorder}" />
            </Style>
            <Style Selector="^ Panel#SearchFieldHost:focus-within Border#SearchFocusRing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ Border#SearchFocusRing">
                <Setter Property="CornerRadius" Value="21" />
            </Style>
            <Style Selector="^ Viewbox#SearchGlyph">
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="15" />
            </Style>
            <Style Selector="^ Viewbox#SearchGlyph > Path, ^ Button#ClearButton Path">
                <Setter Property="Fill" Value="{DynamicResource MacSettingsSecondaryLabelBrush}" />
            </Style>
            <Style Selector="^ Button#ClearButton:pointerover Path, ^ Button#ClearButton:pressed Path">
                <Setter Property="Fill" Value="{DynamicResource MacSettingsLabelBrush}" />
            </Style>
            <Style Selector="^ TextBox#QueryBox">
                <Setter Property="FontFamily" Value="{DynamicResource AppMacControlFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LetterSpacing" Value="{DynamicResource AppMacControlLetterSpacing}" />
                <Setter Property="Foreground" Value="{DynamicResource MacLabelBrush}" />
                <Setter Property="PlaceholderForeground" Value="{DynamicResource MacPlaceholderBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AppMacTextSelectionBrush}" />
                <Setter Property="SelectionForegroundBrush" Value="{DynamicResource MacLabelBrush}" />
            </Style>
            <Style Selector="^ Button.searchChip">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0.5,12,0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource MacControlFill}" />
                <Setter Property="Foreground" Value="{DynamicResource MacLabelBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppMacControlFontFamily}" />
                <Setter Property="LetterSpacing" Value="{DynamicResource AppMacControlLetterSpacing}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style Selector="^ Button.searchChip:pressed">
                <Setter Property="Background" Value="{DynamicResource MacControlFillPressed}" />
            </Style>
            <Style Selector="^ Button.searchChip.selected">
                <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="^ Button.searchChip.selected:pressed">
                <Setter Property="Background" Value="{DynamicResource AppMacAccentPressedBrush}" />
            </Style>
            <Style Selector="^ Button.searchChip.selected TextBlock.chipCount">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^ Button.recentSearch">
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{DynamicResource MacLabelBrush}" />
            </Style>
            <Style Selector="^ Button.recentSearch:pointerover">
                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
            </Style>
        </Style>
        <!-- A window that is not key drops the focus ring and the chips' accent emphasis. -->
        <Style Selector=":is(Window).appleControls.inactive">
            <Style Selector="^ Panel#SearchFieldHost:focus-within Border#SearchFocusRing">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ TextBox#QueryBox">
                <Setter Property="SelectionBrush" Value="{DynamicResource MacUnemphasizedSelection}" />
            </Style>
            <Style Selector="^ Button.searchChip.selected">
                <Setter Property="Background" Value="{DynamicResource MacControlFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource MacLabelBrush}" />
            </Style>
        </Style>
        <!-- Touch chrome: 44-DIP field and rows, and 36-DIP chips, with UIKit text sizes. -->
        <Style Selector=":is(TopLevel).appleTouch">
            <Style Selector="^ Border#SearchField">
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource MacControlFill}" />
            </Style>
            <Style Selector="^ Panel#SearchFieldHost:focus-within Border#SearchFocusRing">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ Viewbox#SearchGlyph">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="14,0,0,0" />
            </Style>
            <Style Selector="^ TextBox#QueryBox">
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style Selector="^ Button.searchChip">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="15,0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style Selector="^ Button.searchChip TextBlock.chipCount">
                <Setter Property="FontSize" Value="13" />
            </Style>
            <!-- The clear glyph and the recent rows stay bare where touch buttons take a filled bezel. -->
            <Style Selector="^ Button#ClearButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style Selector="^ Button.recentSearch">
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="^ Button.recentSearch:pointerover, ^ Button.recentSearch:pressed">
                <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Query field and filters, kept above the results as they scroll. -->
        <StackPanel x:Name="SearchHeader"
                    MaxWidth="1160"
                    Margin="{Binding IsNarrow, Converter={x:Static conv:NarrowInsetConverter.Instance}, ConverterParameter='42,20,42,12|18,8,18,10'}"
                    Spacing="10">
            <Panel x:Name="SearchFieldHost">
                <Border x:Name="SearchField">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Viewbox x:Name="SearchGlyph">
                            <Path Data="{StaticResource IconSearch}" />
                        </Viewbox>
                        <TextBox x:Name="QueryBox"
                                 Grid.Column="1"
                                 Theme="{StaticResource SearchFieldTextBox}"
                                 Text="{Binding Query, Mode=TwoWay}"
                                 PlaceholderText="{Binding Search_Placeholder, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 AutomationProperties.Name="{Binding Common_Search, Source={x:Static strings:LocalizedStrings.Instance}}"
                                 TextInputOptions.ReturnKeyType="Search"
                                 KeyDown="OnQueryKeyDown" />
                        <Button x:Name="ClearButton"
                                Grid.Column="2"
                                Theme="{StaticResource SearchPlainButton}"
                                Command="{Binding ClearQueryCommand}"
                                IsVisible="{Binding Query, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="{Binding SearchBox_Clear, Source={x:Static strings:LocalizedStrings.Instance}}"
                                AutomationProperties.Name="{Binding SearchBox_Clear, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource IconCloseCircle}" />
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
                <Border x:Name="SearchFocusRing" Theme="{StaticResource MacFocusRing}" />
            </Panel>

            <!-- Result kinds scroll sideways where they do not fit; the library filter stays at the end. -->
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer x:Name="ScopeScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="OnScopeScrollerWheel">
                    <ItemsControl x:Name="ScopeItems" ItemsSource="{Binding ScopeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchScopeOption">
                                <Button Theme="{StaticResource SearchPlainButton}"
                                        Classes="searchChip"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.empty="{Binding IsEmpty}"
                                        Command="{Binding SelectCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="chipLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Classes="chipCount"
                                                   Text="{Binding CountText}"
                                                   IsVisible="{Binding CountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="SourceFilterButton"
                        Grid.Column="1"
                        Theme="{StaticResource SearchPlainButton}"
                        Classes="searchChip"
                        Classes.selected="{Binding IsSourceFilterActive}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding ShowSourceFilter}"
                        ToolTip.Tip="{Binding Search_LibrariesHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                        AutomationProperties.Name="{Binding Search_LibrariesHeader, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{StaticResource IconFilter}" />
                        </Viewbox>
                        <TextBlock x:Name="SourceFilterText"
                                   Text="{Binding SourceFilterLabel}"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Viewbox Width="9" Height="9">
                            <Path Data="{StaticResource IconChevronDown}" />
                        </Viewbox>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel MinWidth="200" MaxWidth="300" Spacing="10">
                                <TextBlock Text="{Binding Search_LibrariesHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <ItemsControl ItemsSource="{Binding SourceOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchSourceOption">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
        <ProgressBar Grid.Row="0"
                     Height="2"
                     MinHeight="0"
                     VerticalAlignment="Bottom"
                     IsVisible="{Binding IsWorking}"
                     IsIndeterminate="{Binding IsWorking}" />

        <Border Grid.Row="1" IsVisible="{Binding HasFailures}"
                HorizontalAlignment="Stretch" MaxWidth="1160"
                Margin="{Binding IsNarrow, Converter={x:Static conv:NarrowInsetConverter.Instance}, ConverterParameter='42,8,42,0|18,8,18,0'}"
                Padding="12,8" CornerRadius="6"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppFavoriteBrush}" BorderThickness="1">
            <TextBlock Text="{Binding FailureText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppFavoriteBrush}" />
        </Border>

        <!-- Before a query: recent searches, or a hint when there are none. -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowRecentSearches}">
            <StackPanel MaxWidth="1160"
                        Margin="{Binding IsNarrow, Converter={x:Static conv:NarrowInsetConverter.Instance}, ConverterParameter='42,12,42,32|18,8,18,24'}"
                        Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="10,0,0,0" MinHeight="30">
                    <TextBlock Text="{Binding Search_RecentHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    <Button Grid.Column="1" Classes="headerAction" Command="{Binding ClearRecentSearchesCommand}">
                        <TextBlock Text="{Binding Search_ClearRecent, Source={x:Static strings:LocalizedStrings.Instance}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding RecentSearches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentSearchItem">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Theme="{StaticResource SearchPlainButton}"
                                        Classes="recentSearch"
                                        Command="{Binding SelectCommand}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource AppSecondaryTextBrush}" />
                                        </Viewbox>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding Text}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="{Binding Search_RemoveRecent, Source={x:Static strings:LocalizedStrings.Instance}}"
                                        AutomationProperties.Name="{Binding Search_RemoveRecent, Source={x:Static strings:LocalizedStrings.Instance}}">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource AppSecondaryTextBrush}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" IsVisible="{Binding ShowLandingHint}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24" Spacing="8">
            <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource AppDisabledTextBrush}" />
            </Viewbox>
            <TextBlock Text="{Binding Search_Placeholder, Source={x:Static strings:LocalizedStrings.Instance}}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <TextBlock Text="{Binding Search_LandingDescription, Source={x:Static strings:LocalizedStrings.Instance}}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" FontSize="13"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
        </StackPanel>

        <!-- No results, with a way back to everything when filters narrow the search. -->
        <StackPanel Grid.Row="2" IsVisible="{Binding ShowNoResults}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24" Spacing="8">
            <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource AppDisabledTextBrush}" />
            </Viewbox>
            <TextBlock Text="{Binding Search_NoResultsHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <TextBlock Text="{Binding NoResultsDescription}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" FontSize="13"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <Button HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    IsVisible="{Binding CanClearFilters}"
                    Command="{Binding ClearFiltersCommand}"
                    Content="{Binding Search_ClearFilters, Source={x:Static strings:LocalizedStrings.Instance}}" />
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" x:Name="ResultsScrollViewer" IsVisible="{Binding ShowResults}">
            <StackPanel x:Name="ResultsContent" MaxWidth="1180" HorizontalAlignment="Stretch" SizeChanged="OnResultsSizeChanged"
                        Margin="{Binding IsNarrow, Converter={x:Static conv:NarrowInsetConverter.Instance}, ConverterParameter='32,8,32,32|8,4,8,24'}" Spacing="22">
                <!-- Songs -->
                <StackPanel Spacing="6" IsVisible="{Binding Songs.IsVisible}">
                    <ContentControl Content="{Binding Songs}"
                                    ContentTemplate="{StaticResource SectionHeaderTemplate}"
                                    IsVisible="{Binding Songs.ShowHeader}" />
                    <ItemsControl ItemsSource="{Binding Songs.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:IncrementalVirtualizingStackPanel TotalCount="{Binding Songs.ExtentCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackRowModel">
                                <controls:TrackRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Albums -->
                <StackPanel Spacing="6" IsVisible="{Binding Albums.IsVisible}">
                    <ContentControl Content="{Binding Albums}"
                                    ContentTemplate="{StaticResource SectionHeaderTemplate}"
                                    IsVisible="{Binding Albums.ShowHeader}" />
                    <ItemsControl ItemsSource="{Binding Albums.Items}" Margin="5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformTileGrid MinItemWidth="130"
                                                          MinItemHeight="160"
                                                          MinColumnSpacing="6"
                                                          MinRowSpacing="2"
                                                          TotalCount="{Binding Albums.ExtentCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryTileModel">
                                <Viewbox>
                                    <controls:LibraryTile />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Artists -->
                <StackPanel Spacing="6" IsVisible="{Binding Artists.IsVisible}">
                    <ContentControl Content="{Binding Artists}"
                                    ContentTemplate="{StaticResource SectionHeaderTemplate}"
                                    IsVisible="{Binding Artists.ShowHeader}" />
                    <ItemsControl ItemsSource="{Binding Artists.Items}" Margin="5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformTileGrid MinItemWidth="130"
                                                          MinItemHeight="160"
                                                          MinColumnSpacing="6"
                                                          MinRowSpacing="2"
                                                          TotalCount="{Binding Artists.ExtentCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibraryTileModel">
                                <Viewbox>
                                    <controls:LibraryTile />
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Videos -->
                <StackPanel Spacing="6" IsVisible="{Binding Videos.IsVisible}">
                    <ContentControl Content="{Binding Videos}"
                                    ContentTemplate="{StaticResource SectionHeaderTemplate}"
                                    IsVisible="{Binding Videos.ShowHeader}" />
                    <ItemsControl Classes="mediaResults"
                                  Classes.list="{Binding ShowMediaAsList}"
                                  ItemsSource="{Binding Videos.Items}"
                                  Margin="5,0" />
                </StackPanel>

                <!-- Photos -->
                <StackPanel Spacing="6" IsVisible="{Binding Photos.IsVisible}">
                    <ContentControl Content="{Binding Photos}"
                                    ContentTemplate="{StaticResource SectionHeaderTemplate}"
                                    IsVisible="{Binding Photos.ShowHeader}" />
                    <ItemsControl Classes="mediaResults"
                                  Classes.list="{Binding ShowMediaAsList}"
                                  ItemsSource="{Binding Photos.Items}"
                                  Margin="5,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
