<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:conv="using:LightStudio.LightPlayer.Converters"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             xmlns:views="using:LightStudio.LightPlayer.Views.Pages"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SettingsContentSectionViewModel">
            <ScrollViewer>
                <ContentControl Content="{Binding Content}"
                                MaxWidth="680"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Margin="{Binding ContentMargin}" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:PhotoIndexSettingsViewModel">
            <views:PhotoIndexSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DisplaySettingsViewModel">
            <views:DisplaySettingsSectionView DataContext="{Binding Video}" />
        </DataTemplate>
        <DataTemplate DataType="vm:CustomFiltersSettingsViewModel">
            <views:CustomFiltersSettingsView DataContext="{Binding Video}" />
        </DataTemplate>
        <DataTemplate DataType="vm:RemoteApiSettingsSectionViewModel">
            <views:RemoteApiSettingsSectionView />
        </DataTemplate>
    </UserControl.DataTemplates>
    <UserControl.Styles>
        <Style Selector="ListBox.sectionsList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.sectionsList ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding !IsCategory, DataType=vm:SettingsNavigationItemViewModel}" />
            <Setter Property="IsHitTestVisible" Value="{Binding !IsCategory, DataType=vm:SettingsNavigationItemViewModel}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.sectionsList StackPanel.sectionItems">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style Selector="ListBox.sectionsList Grid.sectionHeader">
            <Setter Property="Margin" Value="16,8" />
        </Style>
        <Style Selector="ListBox.sectionsList Border.sectionRow">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="16,7" />
        </Style>
        <Style Selector="ListBox.sectionsList TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ListBox.sectionsList TextBlock.sectionHeaderTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MaxWidth" Value="190" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.sectionsList Viewbox.sectionIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="ListBox.sectionsList Border.sectionIconTile">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="ListBox.sectionsList Path.sectionGlyph">
            <Setter Property="Fill" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.sectionsList Path.sectionChevronGlyph">
            <Setter Property="Fill" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.sectionsList Viewbox.sectionChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.sectionsList Border.sectionDivider">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="48,0,16,0" />
        </Style>

        <!--
            Narrow layout: each category's rows form one panel shaped like the settings groups of the
            sections they open, with a chevron marking rows that open a page.
        -->
        <Style Selector="ListBox.sectionsList.narrow StackPanel.sectionItems">
            <Setter Property="Margin" Value="16,8,16,16" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="1,0" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow ListBoxItem.first">
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow ListBoxItem.last">
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,6,6" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow ListBoxItem.first.last">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow ListBoxItem:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow Border.sectionRow">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow Viewbox.sectionIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow Viewbox.sectionChevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.sectionsList.narrow Border.sectionDivider">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Apple style: the panels take the shape of its settings groups, without an outline. -->
        <Style Selector=":is(TopLevel).appleControls ListBox.sectionsList.narrow">
            <Style Selector="^ ListBoxItem">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^ ListBoxItem.first">
                <Setter Property="CornerRadius" Value="12,12,0,0" />
            </Style>
            <Style Selector="^ ListBoxItem.last">
                <Setter Property="CornerRadius" Value="0,0,12,12" />
            </Style>
            <Style Selector="^ ListBoxItem.first.last">
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style Selector="^ Border.sectionHeaderRule">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <!--
            Touch metrics follow the iOS Settings list: 17-point labels, 52-DIP rows, 26-DIP corners, glyphs on
            28-DIP colored tiles, and dividers from the label to the trailing inset.
        -->
        <Style Selector=":is(TopLevel).appleTouch controls|MasterDetailView">
            <Setter Property="DetailBackground" Value="{DynamicResource AppGroupedBackgroundBrush}" />
        </Style>
        <Style Selector=":is(TopLevel).appleTouch ListBox.sectionsList.narrow">
            <Style Selector="^ ListBoxItem">
                <Setter Property="Background" Value="{DynamicResource AppGroupedCellBrush}" />
            </Style>
            <Style Selector="^ ListBoxItem:disabled">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style Selector="^ TextBlock.sectionHeaderTitle">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="LetterSpacing" Value="1" />
                <Setter Property="MaxWidth" Value="Infinity" />
                <Setter Property="Foreground" Value="{DynamicResource IosSecondaryLabel}" />
            </Style>
            <Style Selector="^ Border.sectionIconTile">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="Background" Value="{Binding IconKey, Converter={x:Static conv:SettingsIconTintConverter.Instance}, DataType=vm:SettingsNavigationItemViewModel}" />
            </Style>
            <Style Selector="^ Path.sectionGlyph">
                <Setter Property="Fill" Value="White" />
            </Style>
            <Style Selector="^ Viewbox.sectionChevron">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="8,0,-3,0" />
            </Style>
            <Style Selector="^ Path.sectionChevronGlyph">
                <Setter Property="Fill" Value="{DynamicResource IosTertiaryLabel}" />
            </Style>
            <Style Selector="^ ListBoxItem.first">
                <Setter Property="CornerRadius" Value="26,26,0,0" />
            </Style>
            <Style Selector="^ ListBoxItem.last">
                <Setter Property="CornerRadius" Value="0,0,26,26" />
            </Style>
            <Style Selector="^ ListBoxItem.first.last">
                <Setter Property="CornerRadius" Value="26" />
            </Style>
            <Style Selector="^ Grid.sectionHeader">
                <Setter Property="Margin" Value="20,8" />
            </Style>
            <Style Selector="^ Border.sectionRow">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="18,12,20,12" />
            </Style>
            <Style Selector="^ TextBlock.sectionTitle">
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style Selector="^ Viewbox.sectionIcon">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
            </Style>
            <Style Selector="^ Border.sectionDivider">
                <Setter Property="Margin" Value="60,0,20,0" />
            </Style>
        </Style>
        <!-- Selected section uses the theme's selection color rather than the Fluent accent. -->
        <Style Selector="ListBox.sectionsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
        </Style>
        <Style Selector="ListBox.sectionsList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
        </Style>
    </UserControl.Styles>
    <!--
        Adaptive master-detail: the section list and the selected section sit side by side on wide
        layouts (section swaps with the light entrance transition); on narrow layouts the section
        slides in over the list from the right and back out on return. The built-in detail back button
        is used only while the shell has no back button of its own; the narrow layout defers to the
        shell's single global back button, so ShowDetailBackButton is off there. Either back
        path is handled by the page view model first (collapse to the list) before the shell navigates
        away.

        The detail pane has no padding of its own: each section view margins the content inside its
        scroll viewer so the scroll bar stays hard against the window edge.
    -->
    <Panel controls:SettingRowPanel.IsNarrowLayout="{Binding IsNarrow}">
        <controls:MasterDetailView CompactThreshold="680"
                                   MasterLength="250"
                                   IsVisible="{Binding !IsSidebarLayout}"
                                   ShowDetailBackButton="{Binding !HasShellBackButton}"
                                   DetailBackCommand="{Binding BackCommand}"
                                   IsCompact="{Binding IsCompact, Mode=OneWayToSource}"
                                   Detail="{Binding ListLayoutDetail}">
            <controls:MasterDetailView.Master>
                <ListBox x:Name="SectionsList"
                         Classes="sectionsList"
                         Classes.narrow="{Binding IsCompact}"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         AutoScrollToSelectedItem="False"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.Styles>
                        <!-- Class bindings need a selector without conditions, so they are scoped by this list. -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="(Classes.first)" Value="{Binding IsFirstInGroup, DataType=vm:SettingsNavigationItemViewModel}" />
                            <Setter Property="(Classes.last)" Value="{Binding IsLastInGroup, DataType=vm:SettingsNavigationItemViewModel}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Classes="sectionItems" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsNavigationItemViewModel">
                            <Panel>
                                <Grid Classes="sectionHeader" ColumnDefinitions="Auto,*" IsVisible="{Binding IsCategory}">
                                    <TextBlock Classes="sectionHeaderTitle"
                                               Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Classes="sectionHeaderRule"
                                            Height="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AppDividerBrush}" />
                                </Grid>
                                <Border Classes="sectionRow" IsVisible="{Binding !IsCategory}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="sectionIconTile" VerticalAlignment="Center">
                                            <Viewbox Classes="sectionIcon" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Classes="sectionGlyph"
                                                      Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Classes="sectionTitle"
                                                   Text="{Binding Title}"
                                                   FontWeight="Normal"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                        <Viewbox Grid.Column="2"
                                                 Classes="sectionChevron"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="8,0,-4,0"
                                                 VerticalAlignment="Center">
                                            <Path Classes="sectionChevronGlyph" Data="{StaticResource IconChevronRight}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <Border Classes="sectionDivider"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        IsVisible="{Binding !IsLastInGroup}"
                                        Background="{DynamicResource AppDividerBrush}" />
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </controls:MasterDetailView.Master>

            <!-- Detail placeholder: shown on wide layouts when no section is selected -->
            <controls:MasterDetailView.DetailPlaceholder>
                <controls:EmptyState Icon="{StaticResource IconSettings}"
                                     Header="{Binding DetailPlaceholderHeader}"
                                     Description="{Binding DetailPlaceholderDescription}" />
            </controls:MasterDetailView.DetailPlaceholder>
        </controls:MasterDetailView>

        <!-- Sidebar layout: the host's Apple-style sidebar lists the sections; the page shows the open one. -->
        <controls:DispatcherTransitioningContentControl x:Name="SidebarDetailHost"
                                                        IsVisible="{Binding IsSidebarLayout}"
                                                        Content="{Binding SidebarLayoutDetail}"
                                                        PageTransition="{x:Null}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch" />
    </Panel>
</UserControl>