<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             xmlns:services="using:LightStudio.LightPlayer.Services"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.VideoPlaylistDetailPageView"
             x:DataType="vm:VideoPlaylistDetailPageViewModel">
    <controls:PageSearchHost Search="{Binding PageSearch}">
    <DockPanel>
        <controls:MultiSelectBar DockPanel.Dock="Top" DataContext="{Binding Selection}" />
        <!-- Header. Mirrors the music playlist header minus the actions videos have no queue for. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="20,32"
              controls:PageSearchHost.Target="{Binding}">
            <Border Grid.Column="0"
                    Width="120"
                    Height="120"
                    CornerRadius="6"
                    Background="{DynamicResource AppNavBackgroundBrush}">
                <Viewbox Width="56" Height="56">
                    <Path Data="{StaticResource IconVideoPlaylist}"
                          Fill="{DynamicResource AppSecondaryTextBrush}" />
                </Viewbox>
            </Border>

            <DockPanel Grid.Column="1" Margin="20,0,0,0">
                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0"
                                Classes="icon"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                IsVisible="{Binding ShowBackButton}"
                                Command="{Binding BackCommand}"
                                ToolTip.Tip="{Binding Common_Back, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="20" Height="20">
                                <Path Data="{StaticResource IconArrowLeft}"
                                      Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,10,0,0">
                        <Button Classes="icon" Command="{Binding PlayCommand}" ToolTip.Tip="{Binding Common_Play, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{Binding Shell_More, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconMore}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                            </Viewbox>
                            <services:NativeContextMenu.Menu>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Common_Rename, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding RenameCommand}" />
                                    <MenuItem Header="{Binding PlaylistDetail_Export, Source={x:Static strings:LocalizedStrings.Instance}}" Command="{Binding ExportCommand}" />
                                    <Separator IsVisible="{Binding CanDelete}" />
                                    <MenuItem Header="{Binding PlaylistDetail_DeletePlaylist, Source={x:Static strings:LocalizedStrings.Instance}}"
                                              Command="{Binding DeleteCommand}"
                                              IsVisible="{Binding CanDelete}" />
                                </MenuFlyout>
                            </services:NativeContextMenu.Menu>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Items / empty state -->
        <Panel>
            <ScrollViewer IsVisible="{Binding ShowContent}" Margin="10,0,10,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoTileModel">
                            <controls:SelectionItem>
                                <controls:VideoListRow />
                            </controls:SelectionItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <controls:EmptyState IsVisible="{Binding ShowEmpty}"
                                 Header="{Binding EmptyHeader}"
                                 Description="{Binding EmptyDescription}" />
        </Panel>
    </DockPanel>
    </controls:PageSearchHost>
</UserControl>
