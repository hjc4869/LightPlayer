<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:lmr="using:LightMediaRenderer.Avalonia.Controls"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="900"
             x:Class="LightStudio.LightPlayer.Views.Pages.DisplaySettingsSectionView"
             x:DataType="vm:VideoSettingsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="controls|SettingRow TextBlock.settingName">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel>
                <controls:SettingRow Header="{Binding HdrPassthroughHeader}"
                                     Description="{Binding HdrPassthroughDescription}"
                                     IsVisible="{Binding SupportsAdvancedColorOutput}"
                                     IsGrouped="True">
                    <controls:SettingRow.ActionContent>
                        <ToggleSwitch OnContent=""
                                      OffContent=""
                                      IsChecked="{Binding EnableHdrPassthrough, Mode=TwoWay}" />
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>

                <controls:SettingRow Header="{Binding Bt709InterpretationHeader}"
                                     Description="{Binding Bt709InterpretationDescription}"
                                     IsGrouped="True"
                                     HasTopDivider="{Binding SupportsAdvancedColorOutput}">
                    <controls:SettingRow.ActionContent>
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Bt709InterpretationOptions}"
                                  SelectedItem="{Binding SelectedBt709Interpretation, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoSettingsOption">
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>

                <controls:SettingRow Header="{Binding PanelBitDepthHeader}"
                                     Description="{Binding PanelBitDepthDescription}"
                                     IsGrouped="True"
                                     HasTopDivider="True">
                    <controls:SettingRow.ActionContent>
                        <ComboBox Width="150"
                                  ItemsSource="{Binding PanelBitDepthOptions}"
                                  SelectedItem="{Binding SelectedPanelBitDepth, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoSettingsOption">
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
            </StackPanel>
        </Border>

        <StackPanel Spacing="4" Margin="2,14,2,0">
            <TextBlock Text="{Binding Photo_ToneMapping, Source={x:Static strings:LocalizedStrings.Instance}}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryTextBrush}" />
            <TextBlock Text="{Binding ToneMapping_Description, Source={x:Static strings:LocalizedStrings.Instance}}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
        </StackPanel>

        <Border Classes="settingsGroup">
            <StackPanel>
                <controls:SettingRow Header="{Binding ToneMapping_ImageDefaultHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding ToneMapping_ImageDefaultDescription, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     IsGrouped="True">
                    <controls:SettingRow.ActionContent>
                        <ComboBox Width="150"
                                  ItemsSource="{Binding ToneMapping.DefaultChoices}"
                                  SelectedItem="{Binding ToneMapping.SelectedImageDefault, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding ToneMapping_ImageDefaultHeader, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoSettingsOption">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>

                <controls:SettingRow Header="{Binding ToneMapping_VideoDefaultHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding ToneMapping_VideoDefaultDescription, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     IsGrouped="True"
                                     HasTopDivider="True">
                    <controls:SettingRow.ActionContent>
                        <ComboBox Width="150"
                                  ItemsSource="{Binding ToneMapping.DefaultChoices}"
                                  SelectedItem="{Binding ToneMapping.SelectedVideoDefault, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding ToneMapping_VideoDefaultHeader, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoSettingsOption">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel>
                <controls:SettingRow Header="{Binding ToneMapping_ProfilesHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding ToneMapping_ProfilesDescription, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     IsGrouped="True">
                    <controls:SettingRow.ActionContent>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="icon"
                                    Command="{Binding ToneMapping.AddProfileCommand}"
                                    ToolTip.Tip="{Binding ToneMapping_AddProfile, Source={x:Static strings:LocalizedStrings.Instance}}"
                                    AutomationProperties.Name="{Binding ToneMapping_AddProfile, Source={x:Static strings:LocalizedStrings.Instance}}">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconAdd}"
                                          Fill="{DynamicResource AppSecondaryTextBrush}" />
                                </Viewbox>
                            </Button>
                            <Button Classes="icon"
                                    IsVisible="{Binding ToneMapping.HasProfiles}"
                                    Command="{Binding ToneMapping.DeleteProfileCommand}"
                                    ToolTip.Tip="{Binding ToneMapping_DeleteProfile, Source={x:Static strings:LocalizedStrings.Instance}}"
                                    AutomationProperties.Name="{Binding ToneMapping_DeleteProfile, Source={x:Static strings:LocalizedStrings.Instance}}">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconDelete}"
                                          Fill="{DynamicResource AppSecondaryTextBrush}" />
                                </Viewbox>
                            </Button>
                            <ComboBox Width="150"
                                      IsVisible="{Binding ToneMapping.HasProfiles}"
                                      ItemsSource="{Binding ToneMapping.ProfileChoices}"
                                      SelectedItem="{Binding ToneMapping.SelectedProfile, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding ToneMapping_Profile, Source={x:Static strings:LocalizedStrings.Instance}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VideoSettingsOption">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>

                <controls:SettingRow Header="{Binding ToneMapping_Name, Source={x:Static strings:LocalizedStrings.Instance}}"
                                     Description="{Binding ToneMapping.NameError}"
                                     IsVisible="{Binding ToneMapping.HasSelectedProfile}"
                                     IsGrouped="True"
                                     HasTopDivider="True">
                    <controls:SettingRow.ActionContent>
                        <TextBox Width="150"
                                 Text="{Binding ToneMapping.ProfileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="{Binding ToneMapping_Name, Source={x:Static strings:LocalizedStrings.Instance}}" />
                    </controls:SettingRow.ActionContent>
                </controls:SettingRow>

                <Border Classes="settingsDivider" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="16,12">
                    <StackPanel Spacing="6"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                IsVisible="{Binding SupportsAdvancedColorOutput}">
                        <ToggleButton x:Name="HdrHintToggle"
                                      HorizontalAlignment="Center"
                                      Padding="6"
                                      IsChecked="{Binding #ToneChart.IsHdrHintEnabled}"
                                      ToolTip.Tip="{Binding ToneMapping_HdrHint, Source={x:Static strings:LocalizedStrings.Instance}}"
                                      AutomationProperties.Name="{Binding ToneMapping_HdrHint, Source={x:Static strings:LocalizedStrings.Instance}}">
                            <Viewbox Width="24" Height="16">
                                <Grid Width="24" Height="16">
                                    <Path Data="{StaticResource IconHdrOn}"
                                          Fill="{Binding $parent[ToggleButton].Foreground}"
                                          IsVisible="{Binding #HdrHintToggle.IsChecked}" />
                                    <Path Data="{StaticResource IconHdrOff}"
                                          Fill="{Binding $parent[ToggleButton].Foreground}"
                                          IsVisible="{Binding !#HdrHintToggle.IsChecked}" />
                                </Grid>
                            </Viewbox>
                        </ToggleButton>
                        <Slider Orientation="Vertical"
                                Height="150"
                                HorizontalAlignment="Center"
                                Minimum="1"
                                Maximum="16"
                                SmallChange="0.5"
                                LargeChange="2"
                                IsEnabled="{Binding #HdrHintToggle.IsChecked}"
                                Value="{Binding #ToneChart.HdrHintHeadroom}"
                                ToolTip.Tip="{Binding ToneMapping_HdrHintHeadroom, Source={x:Static strings:LocalizedStrings.Instance}}"
                                AutomationProperties.Name="{Binding ToneMapping_HdrHintHeadroom, Source={x:Static strings:LocalizedStrings.Instance}}" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   Text="{Binding #ToneChart.HdrHintHeadroom, StringFormat={}{0:0.0}x}" />
                    </StackPanel>
                    <lmr:ToneMappingChart x:Name="ToneChart"
                                          Grid.Column="1"
                                          Height="240"
                                          Foreground="{DynamicResource AppSecondaryTextBrush}"
                                          ToneMapping="{Binding ToneMapping.ChartToneMapping}"
                                          EnableHdrPassthrough="{Binding EnableHdrPassthrough}"
                                          DisplayToneTarget="{Binding ToneMapping.DisplayTarget, Mode=OneWayToSource}"
                                          InputAxisTitle="{Binding ToneMapping_InputAxis, Source={x:Static strings:LocalizedStrings.Instance}}"
                                          OutputAxisTitle="{Binding ToneMapping_OutputAxis, Source={x:Static strings:LocalizedStrings.Instance}}"
                                          CurrentHeadroomFormat="{Binding ToneMapping_CurrentHeadroomFormat, Source={x:Static strings:LocalizedStrings.Instance}}"
                                          PotentialHeadroomFormat="{Binding ToneMapping_PotentialHeadroomFormat, Source={x:Static strings:LocalizedStrings.Instance}}" />
                </Grid>

                <StackPanel IsVisible="{Binding ToneMapping.HasSelectedProfile}">
                    <Border Classes="settingsDivider" />
                    <controls:ToneMappingEditor Margin="16,12" DataContext="{Binding ToneMapping.Editor}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
