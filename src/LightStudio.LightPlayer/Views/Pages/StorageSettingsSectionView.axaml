<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="360"
             x:Class="LightStudio.LightPlayer.Views.Pages.StorageSettingsSectionView"
             x:DataType="vm:StorageSettingsSectionViewModel">
    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StorageCacheItemViewModel">
                <StackPanel>
                    <controls:SettingRow IsGrouped="True"
                                         HasTopDivider="True"
                                         Header="{Binding Header}"
                                         Description="{Binding Description}">
                        <controls:SettingRow.ActionContent>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="settingsCaption" Text="{Binding UsageText}"
                                           VerticalAlignment="Center" />
                                <Button Classes="icon"
                                        ToolTip.Tip="{Binding StorageSettings_Clear, Source={x:Static strings:LocalizedStrings.Instance}}"
                                        Command="{Binding ClearCommand}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconDelete}"
                                              Fill="{DynamicResource AppSecondaryTextBrush}" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </controls:SettingRow.ActionContent>
                    </controls:SettingRow>

                    <controls:SettingRow IsGrouped="True"
                                         HasTopDivider="True"
                                         IsVisible="{Binding HasLimit}"
                                         Header="{Binding StorageSettings_LimitHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                                         Description="{Binding StorageSettings_LimitDescription, Source={x:Static strings:LocalizedStrings.Instance}}"
                                         ActionWidth="150">
                        <controls:SettingRow.ActionContent>
                            <controls:NumberEntry Minimum="{Binding MinimumLimitMebibytes}"
                                                  Maximum="{Binding MaximumLimitMebibytes}"
                                                  Increment="64"
                                                  FormatString="0"
                                                  Number="{Binding LimitMebibytes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </controls:SettingRow.ActionContent>
                    </controls:SettingRow>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
