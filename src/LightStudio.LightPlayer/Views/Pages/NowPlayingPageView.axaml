<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="using:LightStudio.LightPlayer.Strings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:LightStudio.LightPlayer.Controls"
             xmlns:models="using:LightStudio.LightPlayer.Models"
             xmlns:vm="using:LightStudio.LightPlayer.ViewModels.Pages"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="640"
             x:Class="LightStudio.LightPlayer.Views.Pages.NowPlayingPageView"
             xmlns:animations="using:LightStudio.LightPlayer.Animations"
             x:DataType="vm:NowPlayingPageViewModel">
    <UserControl.Styles>
        <Style Selector="Button.metaLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.metaLink /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.metaLink:pointerover">
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>

        <Style Selector="Button.pageDot">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pageDot /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.pageDot:pointerover Ellipse.pageDot">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Ellipse.pageDot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Fill" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="Ellipse.pageDot.current">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Margin="32,32,32,16">
    <Panel x:Name="PagerHost" Background="Transparent" ClipToBounds="True">
    <Grid x:Name="RootGrid" Width="0" HorizontalAlignment="Left" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    x:Name="MetadataPanel"
                    Width="240"
                    Margin="0,0,30,0"
                    VerticalAlignment="Top"
                    Spacing="7">
            <controls:MediaThumbnail Width="240"
                                     animations:ConnectedArtwork.Key="{Binding ArtworkKey}"
                                     Height="240"
                                     HorizontalAlignment="Left"
                                     CornerRadius="8"
                                     Source="{Binding AlbumImage}"
                                     PlaceholderKind="Album" />
            <SelectableTextBlock Text="{Binding TrackTitle}"
                                 FontSize="24"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}" />
            <Button Classes="metaLink"
                    Command="{Binding OpenArtistCommand}"
                    ToolTip.Tip="{Binding Common_GoToArtist, Source={x:Static strings:LocalizedStrings.Instance}}">
                <TextBlock Text="{Binding Artist}"
                           FontSize="15"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </Button>
            <Button Classes="metaLink"
                    Command="{Binding OpenAlbumCommand}"
                    ToolTip.Tip="{Binding Common_GoToAlbum, Source={x:Static strings:LocalizedStrings.Instance}}">
                <TextBlock Text="{Binding Album}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </Button>
        </StackPanel>

          <Grid Grid.Column="1"
              x:Name="LyricsPanel"
              RowDefinitions="Auto,*"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Classes="sectionHeader"
                       Text="{Binding NowPlaying_LyricsHeader, Source={x:Static strings:LocalizedStrings.Instance}}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        Orientation="Vertical"
                        Spacing="8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right">
                <Button Classes="icon"
                        Command="{Binding OffsetEarlierCommand}"
                        ToolTip.Tip="{Binding NowPlaying_LyricsEarlier, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconChevronUp}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                    </Viewbox>
                </Button>
                <Button Classes="icon"
                        Command="{Binding OffsetLaterCommand}"
                        ToolTip.Tip="{Binding NowPlaying_LyricsLater, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconChevronDown}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                    </Viewbox>
                </Button>
                <Button Classes="icon"
                        Command="{Binding SearchLyricsCommand}"
                        ToolTip.Tip="{Binding NowPlaying_SearchLyrics, Source={x:Static strings:LocalizedStrings.Instance}}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <Panel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                <ProgressBar IsVisible="{Binding LrcSearchBusy}"
                             IsIndeterminate="{Binding LrcSearchBusy}"
                             Width="140"
                             Height="4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                <TextBlock IsVisible="{Binding ShowNoLyricsMessage}"
                           Text="{Binding NoLyricsMessage}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           MaxWidth="320"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <controls:LyricsPresenter x:Name="LyricsControl"
                                          IsVisible="{Binding HasLyrics}"
                                          LinesSource="{Binding Lines}"
                                          CurrentIndex="{Binding CurrentIndex}" />
            </Panel>
        </Grid>

        <Grid Grid.Column="2"
              x:Name="UpcomingPanel"
              Margin="24,0,0,0"
              RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Classes="sectionHeader"
                       Margin="5,0,0,0"
                       Text="{Binding NowPlaying_UpcomingHeader, Source={x:Static strings:LocalizedStrings.Instance}}" />
            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:LibraryTileModel">
                            <Viewbox Margin="0,0,12,16" Width="150">
                                <controls:LibraryTile />
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Panel>

    <StackPanel Grid.Row="1"
                x:Name="PageDots"
                IsVisible="False"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">
        <Button Classes="pageDot"
                Tag="0"
                Click="OnPageDotClick"
                AutomationProperties.Name="{Binding NowPlaying_TabTrack, Source={x:Static strings:LocalizedStrings.Instance}}"
                ToolTip.Tip="{Binding NowPlaying_TabTrack, Source={x:Static strings:LocalizedStrings.Instance}}">
            <Ellipse x:Name="MetadataDot" Classes="pageDot" />
        </Button>
        <Button Classes="pageDot"
                Tag="1"
                Click="OnPageDotClick"
                AutomationProperties.Name="{Binding NowPlaying_TabLyrics, Source={x:Static strings:LocalizedStrings.Instance}}"
                ToolTip.Tip="{Binding NowPlaying_TabLyrics, Source={x:Static strings:LocalizedStrings.Instance}}">
            <Ellipse x:Name="LyricsDot" Classes="pageDot" />
        </Button>
        <Button Classes="pageDot"
                Tag="2"
                Click="OnPageDotClick"
                AutomationProperties.Name="{Binding NowPlaying_TabUpNext, Source={x:Static strings:LocalizedStrings.Instance}}"
                ToolTip.Tip="{Binding NowPlaying_TabUpNext, Source={x:Static strings:LocalizedStrings.Instance}}">
            <Ellipse x:Name="UpcomingDot" Classes="pageDot" />
        </Button>
    </StackPanel>
    </Grid>
</UserControl>
