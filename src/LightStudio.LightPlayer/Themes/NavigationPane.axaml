<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navigation pane entries, shared by the shell's navigation pane and the settings window's sidebar. -->
    <Style Selector="DockPanel.navPane TextBlock.navLabel">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style Selector="DockPanel.navPane.expanded TextBlock.navLabel">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="DockPanel.navPane StackPanel.navContent, DockPanel.navPane DockPanel.navContent">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <!-- Status rows trim their captions, so they keep clear of the row's right edge. -->
    <Style Selector="DockPanel.navPane DockPanel.navContent">
        <Setter Property="Margin" Value="12,0,12,0" />
    </Style>
    <Style Selector="DockPanel.navPane Viewbox.navGlyph">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="DockPanel.navPane Path.navIcon">
        <Setter Property="Fill" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.navSection">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Apple layout sidebar: compact, accent-tinted entries with rounded hover and selection fills. -->
    <Style Selector="DockPanel.navPane.apple">
        <Style Selector="^ Panel.railSearch, ^ Button.navMore, ^ Button.navQueue, ^ Border.navDivider">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ Button.nav">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="^ Border.navIndicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ StackPanel.navContent">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="^ DockPanel.navContent">
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>
        <Style Selector="^ Viewbox.navGlyph">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="^ Path.navIcon">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="^ TextBlock.navLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="^ Button.nav.selected TextBlock.navLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}" />
        </Style>
        <Style Selector="^ Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter, ^ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelectionBrush}" />
        </Style>
    </Style>
    <Style Selector="TextBlock.navSection">
        <Setter Property="Margin" Value="20,14,10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>
    <Style Selector="DockPanel.navPane.apple.expanded TextBlock.navSection">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Touch chrome: iPadOS sidebar rows, 44 DIPs tall with capsule fills, 24-DIP glyphs, and 17-point labels. -->
    <Style Selector=":is(TopLevel).appleTouch DockPanel.navPane.apple">
        <Style Selector="^ Button.nav">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style Selector="^ StackPanel.navContent">
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="^ DockPanel.navContent">
            <Setter Property="Margin" Value="16,0,16,0" />
        </Style>
        <Style Selector="^ Viewbox.navGlyph">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="^ TextBlock.navLabel">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
        <Style Selector="^ Button.nav.selected TextBlock.navLabel">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="^ TextBlock.navSection">
            <Setter Property="Margin" Value="32,18,16,6" />
            <Setter Property="FontSize" Value="17" />
        </Style>
    </Style>
    <!-- A rail centers the glyphs in its collapsed width and keeps them in place as the sidebar opens over
         the page. Its headings show only once the sidebar has fully opened (fullyOpen, set by the shell). -->
    <Style Selector=":is(TopLevel).appleTouch DockPanel.navPane.apple.rail">
        <Style Selector="^ Button.nav">
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector="^ StackPanel.navContent">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="^ DockPanel.navContent">
            <Setter Property="Margin" Value="12,0,12,0" />
        </Style>
        <Style Selector="^ TextBlock.navSection">
            <Setter Property="Margin" Value="24,18,12,6" />
        </Style>
        <Style Selector="^:not(.fullyOpen) TextBlock.navSection">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Style>
</Styles>
