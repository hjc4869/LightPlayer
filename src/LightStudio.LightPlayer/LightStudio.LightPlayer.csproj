<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared application library
    =========================
    Contains the whole Avalonia application (App, Views, ViewModels, Services,
    themes, converters, and assets) as a class library so it can be hosted by any
    platform head. LightMediaRenderer.Avalonia supplies playback orchestration,
    A/V synchronization, graphics integration, and the VideoView and PhotoView controls.
    LightMediaRenderer supplies Skia video/photo and subtitle rendering. Playback consumes the same
    IAudioOutputDevice backends as music playback. The desktop head
    (LightStudio.LightPlayer.Desktop) supplies the entry point, the WinExe output
    type, NativeAOT publishing, and the desktop windowing backends; the Android head
    (LightStudio.LightPlayer.Android) supplies its own. Keep this project free of
    platform-backend dependencies (such as Avalonia.Desktop) so non-desktop heads can
    reference it. Native declarations use the target profile propagated by each head.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <RootNamespace>LightStudio.LightPlayer</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsStoreRelease Condition="'$(IsStoreRelease)' == ''">false</IsStoreRelease>
    <DefineConstants Condition="'$(IsStoreRelease)' == 'true'">$(DefineConstants);STORE_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="lmc" />
    <InternalsVisibleTo Include="lmcdroid" />
    <InternalsVisibleTo Include="lmcios" />
    <InternalsVisibleTo Include="lmcweb" />
    <InternalsVisibleTo Include="LightStudio.LocalServices" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resource\lrclib.js" LogicalName="LightStudio.LightPlayer.Resource.lrclib.js" />
    <EmbeddedResource Include="Resource\netease.js" LogicalName="LightStudio.LightPlayer.Resource.netease.js" />
  </ItemGroup>

  <!--
    Legal notices shown in the About dialog. The repository-root LICENSE and
    THIRDPARTY.txt files are embedded with stable manifest names so they can be
    read at runtime via Assembly.GetManifestResourceStream (AOT/trim safe).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LightStudio.LightPlayer.Resource.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRDPARTY.txt" LogicalName="LightStudio.LightPlayer.Resource.THIRDPARTY.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
  </ItemGroup>

  <!-- Video rendering integration -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightMediaRenderer\LightMediaRenderer.csproj" />
    <ProjectReference Include="..\LightMediaRenderer.Avalonia\LightMediaRenderer.Avalonia.csproj" />
    <ProjectReference Include="..\LightStudio.FfmpegShim\LightStudio.FfmpegShim.csproj" />
    <ProjectReference Include="..\LightStudio.MediaLibraryCore.Contracts\LightStudio.MediaLibraryCore.Contracts.csproj" />
  </ItemGroup>

  <!--
    Localization resources. The neutral Resources.resx is embedded by the SDK's
    default glob (manifest name LightStudio.LightPlayer.Strings.Resources), and the
    source generator exposes Resources and LocalizedStrings properties at compile
    time. Culture-specific resx files alongside it supply translations.
  -->
  <ItemGroup>
    <AdditionalFiles Include="Strings\Resources.resx" />
    <ProjectReference Include="..\..\tools\LightStudio.LightPlayer.Generators\LightStudio.LightPlayer.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\..\build\BuildSourceVersion.targets" />
  <PropertyGroup>
    <NativeBindingsEnabled>true</NativeBindingsEnabled>
  </PropertyGroup>
</Project>
