<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <FfmpegApiMajor Condition="'$(FfmpegApiMajor)' == '' and '$(Flatpak)' == 'true'">8</FfmpegApiMajor>
    <FfmpegApiMajor Condition="'$(FfmpegApiMajor)' == ''">$(LightStudioFfmpegVersion.Split('.')[0])</FfmpegApiMajor>
    <DefineConstants>$(DefineConstants);FFMPEG$(FfmpegApiMajor)</DefineConstants>
    <NativeBindingsEnabled>true</NativeBindingsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restore uses this project's own selection; heads that select a package runtime themselves reference the package directly. -->
    <PackageReference Include="LightStudio.Ffmpeg" GeneratePathProperty="true" Condition="'$(UseFfmpegPackage)' == 'true'" />
    <ProjectReference Include="..\LightMediaRenderer\LightMediaRenderer.csproj" />
    <ProjectReference Include="..\LightStudio.Logging\LightStudio.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LightMediaRenderer\Software\*.cs" Link="Software\%(Filename)%(Extension)" />
    <Compile Include="..\LightMediaRenderer\Rendering\VideoColorGamut.cs" Link="Software\VideoColorGamut.cs" />
  </ItemGroup>

  <!-- The native runtime is selected after this file is evaluated, so its define is added before compilation. -->
  <Target Name="DefineFfmpegShimTargetPlatform" BeforeTargets="GenerateNativeBindingsManifest;CoreCompile"
          Condition="$(NativeBindingsRuntime.StartsWith('win-'))">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
