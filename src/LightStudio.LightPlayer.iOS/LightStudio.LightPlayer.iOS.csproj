<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lmpios</AssemblyName>
    <RootNamespace>LightStudio.LightPlayer.iOS</RootNamespace>
    <TargetFramework>$(TargetFramework)-ios</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>im.hjc.LightPlayer</ApplicationId>
    <ApplicationTitle>Light Player</ApplicationTitle>
    <AppIcon>AppIcon</AppIcon>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <UseMonoRuntime>false</UseMonoRuntime>
    <PublishAot>true</PublishAot>
    <EnableStaticFfmpeg>true</EnableStaticFfmpeg>
    <_IsPublishing>true</_IsPublishing>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LightStudio.Onnx" />
    <ProjectReference Include="..\LightStudio.Inference.Onnx\LightStudio.Inference.Onnx.csproj" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="CoreML" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LightStudio.LightPlayer.Desktop\Apple\PlaybackThread.cs" Link="Playback\PlaybackThread.cs" />
    <Compile Include="..\LightStudio.LightPlayer.Desktop\Apple\VideoToolboxSurfaceImporter.cs" Link="Playback\VideoToolboxSurfaceImporter.cs" />
    <Compile Include="..\LightStudio.LightPlayer.Desktop\Apple\VideoToolboxVideoScaler.cs" Link="Playback\VideoToolboxVideoScaler.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="LightStudio.Ffmpeg" />
    <PackageReference Include="LightStudio.Photos" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="CoreMedia" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="CoreVideo" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="VideoToolbox" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AudioToolbox" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AVFoundation" />
    <LinkerArgument Include="-lc++" />
    <LinkerArgument Include="-lz" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="__Internal" />
    <DirectPInvoke Include="liblcms2" />
    <DirectPInvoke Include="libraw" />
    <DirectPInvoke Include="libjpegxr" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightStudio.Logging\LightStudio.Logging.csproj" />
    <ProjectReference Include="..\LightStudio.LocalServices\LightStudio.LocalServices.csproj" />
    <ProjectReference Include="..\LightStudio.Lyrics.Jint\LightStudio.Lyrics.Jint.csproj" />
    <ProjectReference Include="..\LightStudio.RemoteServices\LightStudio.RemoteServices.csproj" />
    <ProjectReference Include="..\LightStudio.LightPlayer\LightStudio.LightPlayer.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeBindingsEnabled>true</NativeBindingsEnabled>
  </PropertyGroup>
</Project>